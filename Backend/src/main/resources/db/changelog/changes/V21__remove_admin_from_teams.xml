<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Yönetici (admin) kullanıcısı birim üyesi olarak tutulmamalı; V4 tüm birimlere eklemişti. -->
    <changeSet id="remove_admin_user_teams" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="user_teams"/>
            <tableExists tableName="users"/>
        </preConditions>
        <comment>Remove default admin user from all team memberships (admin is not a birim member)</comment>
        <sql>
            DELETE FROM user_teams ut
            WHERE ut.user_id IN (SELECT id FROM users WHERE username = 'admin');
        </sql>
    </changeSet>

</databaseChangeLog>
